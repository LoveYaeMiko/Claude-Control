# Claude-Control 中继服务配置
# 复制为 .env 后按需修改（不填则使用默认值）

# 监听端口（默认 9876）
CC_PORT=9876

# WebSocket 连接令牌（留空则启动时随机生成并打印）
# 手机/浏览器连接地址中的 ?token= 需与此一致
CC_TOKEN=

# 内网穿透模式: lan | ngrok | cloudflared | none
#   lan         同一局域网直连（默认，免账号免配置）
#   cloudflared 手机在公网时使用，免账号（需安装 cloudflared.exe）
#   ngrok       需要账号 authtoken（见 ACCOUNTS.md）
#   none        仅本机 127.0.0.1 可访问
CC_TUNNEL=lan

# ngrok authtoken（仅 CC_TUNNEL=ngrok 时需要）
# 获取: https://dashboard.ngrok.com/get-started/your-authtoken
CC_NGROK_AUTH_TOKEN=

# Claude Code transcript 目录（默认 %USERPROFILE%\.claude\projects）
# CC_TRANSCRIPTS_DIR=

# 手机端远程交互（向 Claude Code 发送 prompt 并执行）
# 1 开启；默认 0 关闭。开启后手机端可让 Claude Code 在电脑上执行任务，
# 相当于把电脑执行权限交给持有 token 的人，请谨慎。
CC_ALLOW_INTERACT=1

# 远程交互的权限模式（仅 CC_ALLOW_INTERACT=1 时生效）
#   bypassPermissions  完整控制（默认）：可改文件、执行任意命令
#   acceptEdits        自动放行文件编辑，命令需白名单
#   plan               只读/调研：不能改文件或执行命令
CC_INTERACT_PERMISSION_MODE=bypassPermissions

# 远程交互使用的模型（留空 = 使用 Claude Code 默认模型）
# CC_INTERACT_MODEL=

# 调试日志: 1 开启
CC_DEBUG=0
