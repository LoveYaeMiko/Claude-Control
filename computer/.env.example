# Claude-Control 中继服务配置
# 复制为 .env 后按需修改（不填则使用默认值）

# 监听端口（默认 9876）
CC_PORT=9876

# WebSocket 连接令牌（留空则启动时随机生成并打印）
# 手机/浏览器连接地址中的 ?token= 需与此一致
CC_TOKEN=

# 内网穿透模式: lan | ngrok | cloudflared | none
#   lan         同一局域网直连（默认，免账号免配置）
#   cloudflared 手机在公网时使用，免账号（需安装 cloudflared.exe）
#   ngrok       需要账号 authtoken（见 ACCOUNTS.md）
#   none        仅本机 127.0.0.1 可访问
CC_TUNNEL=lan

# ngrok authtoken（仅 CC_TUNNEL=ngrok 时需要）
# 获取: https://dashboard.ngrok.com/get-started/your-authtoken
CC_NGROK_AUTH_TOKEN=

# Claude Code transcript 目录（默认 %USERPROFILE%\.claude\projects）
# CC_TRANSCRIPTS_DIR=

# 手机端远程交互（向 Claude Code 发送 prompt 并执行）
# 1 开启；默认 0 关闭。开启后手机端可让 Claude Code 在电脑上执行任务，
# 相当于把电脑执行权限交给持有 token 的人，请谨慎。
CC_ALLOW_INTERACT=1

# 远程交互的权限模式（仅 CC_ALLOW_INTERACT=1 时生效）
#   bypassPermissions  完整控制（默认）：可改文件、执行任意命令，不弹审批
#   acceptEdits        自动放行文件编辑，命令需白名单
#   plan               只读/调研：不能改文件或执行命令
#   default            标准审批模式：Claude 弹出的工具权限请求会实时推送到手机，
#                      由手机端点「允许/拒绝」（本模式不拼 --dangerously-skip-permissions）
CC_INTERACT_PERMISSION_MODE=bypassPermissions

# 远程交互使用的模型（留空 = 使用 Claude Code 默认模型）
# CC_INTERACT_MODEL=

# 单个附件（图片/PDF）解码后最大字节数（默认 20 MiB）
# CC_INTERACT_MAX_UPLOAD_MB=20

# 单次权限审批超时秒数（默认 300，超时自动拒绝）
# CC_INTERACT_PERMISSION_TIMEOUT=300

# 单轮交互整体超时秒数（默认 600，超时终止 claude 进程）
# CC_INTERACT_TURN_TIMEOUT=600

# claude CLI 可执行路径（默认 claude；测试注入替身用，一般无需改）
# CC_CLAUDE_BIN=claude

# 新建会话的工作目录（默认用户主目录 ~；恢复已有会话时仍用其原始 cwd）
# 让新会话脱离 Claude-Control 项目文件夹，并避免多会话争用同一项目锁
# CC_DEFAULT_CWD=

# 启动时自动在默认浏览器打开连接面板（显示 url / token / 二维码 / 已连接设备）
# 1 开启（默认）；0 关闭
CC_AUTO_OPEN=1

# 调试日志: 1 开启
CC_DEBUG=0

# 启动生成的二维码 PNG 保存路径（默认项目根目录 Claude-Control/连接二维码.png）
# CC_QR_PNG_PATH=

# 邮件通知：启动时把连接地址/token/二维码发到指定邮箱
# CC_EMAIL_TO=you@qq.com              # 收件人
# CC_EMAIL_USER=you@qq.com            # SMTP 发件账号（QQ 邮箱即收件人）
# CC_EMAIL_AUTH_CODE=                 # SMTP 授权码（QQ 邮箱→设置→账户→开启 SMTP 后获取，非登录密码）
# CC_EMAIL_SMTP_HOST=smtp.qq.com      # SMTP 服务器
# CC_EMAIL_SMTP_PORT=465              # SMTP 端口（QQ 用 465/SSL）
# CC_EMAIL_FROM_NAME=Claude-Control   # 发件人显示名
